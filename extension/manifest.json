{
  "manifest_version": 3,
  "name": "Deadline Tracker",
  "version": "1.0.0",
  "key": "",
  "description": "Keeps track of deadlines from Learn and Crowdmark and adds them to your calendar.",
  "permissions": ["storage", "identity", "alarms", "scripting"],
  "host_permissions": [
    "https://learn.uwaterloo.ca/*",
    "https://app.crowdmark.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "803540093160-ondsvl2mjk7ie3raeg0er5ipkd8ubpea.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.app.created"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deadline Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
